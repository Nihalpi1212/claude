{
  "name": "pigment",
  "productName": "Pigment",
  "version": "0.2.0",
  "description": "Free, open-source image editor for Windows and macOS: layers, masks, brushes, selections, adjustments, filters, text, vector shapes, PSD import and export.",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Pigment contributors",
  "homepage": "https://github.com/Nihalpi1212/claude",
  "scripts": {
    "postinstall": "node scripts/build-vendor.mjs",
    "start": "electron .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "test:electron": "playwright test -c tests/electron/playwright.config.mjs",
    "dev:web": "node tests/e2e/server.mjs 8766",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "ag-psd": "31.0.3",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nihalpi1212/claude.git",
    "directory": "pigment"
  },
  "build": {
    "appId": "com.pigmentapp.app",
    "productName": "Pigment",
    "copyright": "Copyright © 2026 Pigment contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "pigment-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "pigment",
        "name": "Pigment Document",
        "description": "Pigment layered image",
        "role": "Editor"
      },
      {
        "ext": "psd",
        "name": "Photoshop Document",
        "role": "Editor"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "role": "Editor"
      },
      {
        "ext": "jpg",
        "name": "JPEG Image",
        "role": "Editor"
      },
      {
        "ext": "jpeg",
        "name": "JPEG Image",
        "role": "Editor"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Editor"
      },
      {
        "ext": "gif",
        "name": "GIF Image",
        "role": "Editor"
      },
      {
        "ext": "bmp",
        "name": "Bitmap Image",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "notarize": false,
      "identity": null,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Pigment",
      "artifactName": "pigment-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "pigment-${version}-win-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "pigment-${version}-linux-${arch}.${ext}"
    },
    "publish": null
  }
}
