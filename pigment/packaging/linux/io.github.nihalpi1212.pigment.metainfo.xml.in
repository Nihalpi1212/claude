<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.nihalpi1212.pigment</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Pigment</name>
  <summary>Edit photos and layered PSD documents</summary>
  <developer id="io.github.nihalpi1212">
    <name>Pigment contributors</name>
  </developer>
  <description>
    <p>
      Pigment is a free, open-source, native image editor with the familiar menus,
      shortcuts, panels and tools professionals expect: layers, masks, adjustment
      layers, layer styles, type and brushes.
    </p>
    <p>
      Pigment is based on PhotoCraft by the ArtCraft team and the PhotoCraft
      contributors (MIT OR Apache-2.0).
    </p>
    <ul>
      <li>Open, edit and save layered PSD and PSB files</li>
      <li>8-bit, 16-bit and 32-bit float documents in RGB, grayscale, CMYK and Lab</li>
      <li>A GPU compositor with multithreaded filters</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.nihalpi1212.pigment.desktop</launchable>
  <icon type="stock">io.github.nihalpi1212.pigment</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <!-- Pigment's tree and user guide at this version's tag: the repository's default branch holds
       the JavaScript app (Pigment 0.1 to 0.4). -->
  <url type="homepage">https://github.com/Nihalpi1212/claude/tree/pigment-v@VERSION@/pigment</url>
  <url type="bugtracker">https://github.com/Nihalpi1212/claude/issues</url>
  <url type="help">https://github.com/Nihalpi1212/claude/tree/pigment-v@VERSION@/pigment/docs/user</url>
  <url type="contact">https://github.com/Nihalpi1212/claude/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing The Great Wave off Kanagawa with type layers and adjustment layers</caption>
      <image>https://raw.githubusercontent.com/Nihalpi1212/claude/pigment-v@VERSION@/pigment/docs/images/photocraft-demo.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#fbc7dc</color>
    <color type="primary" scheme_preference="dark">#9d174d</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pigment</binary>
    <binary>pigment-cli</binary>
    <mediatype>application/x-pigment</mediatype>
    <mediatype>application/x-photocraft</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>application/x-krita</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psb</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
