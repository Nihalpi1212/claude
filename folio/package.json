{
  "name": "folio-pdf",
  "productName": "Folio PDF",
  "version": "0.1.0",
  "description": "Free, open-source PDF reader for Windows and macOS: view, search, annotate, fill forms, sign, and organize pages.",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Folio PDF contributors",
  "homepage": "https://github.com/Nihalpi1212/claude",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dev:web": "node tests/e2e/server.mjs 8765",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "test:electron": "playwright test -c tests/electron/playwright.config.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.56.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nihalpi1212/claude.git",
    "directory": "folio"
  },
  "build": {
    "appId": "com.foliopdf.app",
    "productName": "Folio PDF",
    "copyright": "Copyright © 2026 Folio PDF contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "folio-pdf-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "notarize": false,
      "identity": null,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Folio PDF",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "folio-pdf-${version}-win-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "mimeTypes": [
        "application/pdf"
      ],
      "maintainer": "Folio PDF contributors",
      "synopsis": "Free PDF reader"
    },
    "publish": null
  }
}
